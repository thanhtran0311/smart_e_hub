  CHARGING_PRIORITY
  USER_REDIRECT
}

enum BottleneckType {
  VEHICLE_SHORTAGE
  PARKING_FULL
  CHARGING_QUEUE_OVERLOAD
}

enum NotificationType {
  REDIRECT_SUGGESTION
  DISPATCH_ALERT
  SYSTEM_ALERT
}

enum AuditAction {
  TEMPLATE_SAVED
  SIMULATION_RUN
  SIMULATION_FAILED
  RECOMMENDATION_APPLIED
  RECOMMENDATION_REJECTED
  APPLY_ROLLED_BACK
}

SimulationService "1" --> "0..*" SimulationScenario
SimulationScenario "0..1" <-- "0..*" SimulationScenario : nạp từ mẫu
SimulationScenario "1" --> "0..*" Recommendation
SimulationService ..> RecommendationService
SimulationService --> OperationalStore
SimulationService ..> AuditLogService
RecommendationService "1" --> "0..*" Recommendation
RecommendationService ..> SimulationScenario
RecommendationService --> OperationalStore
RecommendationService ..> NotificationService
RecommendationService ..> AuditLogService
NotificationService "1" --> "0..*" Notification
AuditLogService "1" --> "0..*" AuditLog
@enduml
